# Supabase Edge Functions Environment Variables
# Copy this file to .env.local and fill in your actual values

# Brevo Credentials
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME="Your Sender Name"
BREVO_SENDER_EMAIL=your-sender@email.com

# Meta (Facebook/WhatsApp) Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# PayPal Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Application URL
APP_URL=http://localhost:3000

# Webhook & Cron Secrets (generate secure random strings)
BOOKING_WEBHOOK_SECRET=generate_a_secure_random_string
WHATSAPP_WEBHOOK_SECRET=generate_a_secure_random_string
CRON_SECRET=generate_a_secure_random_string
