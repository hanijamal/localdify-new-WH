# Backend Environment Variables (WhatsApp Service)
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Webhook Secret (must match the one in Supabase functions)
BOOKING_WEBHOOK_SECRET=same_as_supabase_functions_secret

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER=your_whatsapp_business_number
